# Copy this file to .env and put your real keys after the = signs.
# The real .env file is ignored by git, so your keys stay on your laptop.
VT_API_KEY=
ABUSEIPDB_API_KEY=

# The AI model. Default is Groq (free plan). Get a key at console.groq.com/keys
LLM_API_KEY=
# Optional. Only change these to switch to another provider or model.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
